# Supabase Configuration
# Replace these values with your project credentials from the Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Site URL Configuration (Set to your Vercel deployment domain in production, e.g. https://exammate.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
