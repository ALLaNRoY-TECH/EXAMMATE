# Supabase Configuration
# Replace these values with your project credentials from the Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL Configuration (Set to your Vercel deployment domain in production, e.g. https://exammate.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push VAPID Configuration
# Generate VAPID keys using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@exammate.app
